#!/usr/bin/env python3
"""Emit structured Slurm task check events as per-task JSONL."""

import argparse
import json
import os
import socket
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

STATES = ("queued", "running", "passed", "failed", "warning", "skipped", "cancelled")


def identity(args):
    job = args.job or os.environ.get("SLURM_JOB_ID", "")
    step = args.step or os.environ.get("SLURM_STEP_ID", "batch")
    task = args.task
    if task is None:
        task = os.environ.get("SLURM_PROCID", "0")
    if not str(job).isdigit() or not str(task).isdigit():
        raise SystemExit("job and task must be numeric (or set SLURM_JOB_ID/SLURM_PROCID)")
    if not all(ch.isalnum() or ch in "._-" for ch in str(step)):
        raise SystemExit("step contains unsupported characters")
    return str(job), str(step), str(task)


def emit(args):
    job, step, task = identity(args)
    root = Path(args.root or os.environ.get("SLURMWEB_CHECKS_DIR", "/mnt/ai-data/.slurm-web/checks"))
    directory = root / job / step
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"task-{int(task):04d}.jsonl"
    now_ns = time.time_ns()
    event = {
        "schema": 1,
        "seq": now_ns,
        "timestamp": datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
        "job_id": int(job),
        "step_id": step,
        "task_id": int(task),
        "node": args.node or os.environ.get("SLURMD_NODENAME") or socket.gethostname(),
        "check_id": args.check_id,
        "title": args.title or args.check_id.replace("-", " ").replace("_", " ").title(),
        "state": args.state,
        "message": args.message or "",
        "progress": args.progress,
        "current": args.current,
        "total": args.total,
        "duration_ms": args.duration_ms,
        "metrics": dict(item.split("=", 1) for item in args.metric),
    }
    encoded = json.dumps(event, separators=(",", ":"), ensure_ascii=False) + "\n"
    with path.open("a", encoding="utf-8") as stream:
        stream.write(encoded)
        stream.flush()
        os.fsync(stream.fileno())
    if args.print_event:
        print(json.dumps({"event": event, "path": str(path)}, separators=(",", ":")))


def section(argv):
    """Print a GitLab-compatible log section marker so Slurm-web folds the output.

    slurm-check section start NAME [TITLE] [--collapsed]
    slurm-check section end NAME
    """
    parser = argparse.ArgumentParser(prog="slurm-check section")
    parser.add_argument("action", choices=("start", "end"))
    parser.add_argument("name")
    parser.add_argument("title", nargs="?")
    parser.add_argument("--collapsed", action="store_true")
    args = parser.parse_args(argv)
    if not all(ch.isalnum() or ch in "._-" for ch in args.name):
        raise SystemExit("section name may only contain letters, digits, . _ -")
    stamp = int(time.time())
    if args.action == "start":
        options = "[collapsed=true]" if args.collapsed else ""
        title = args.title or args.name.replace("-", " ").replace("_", " ").title()
        sys.stdout.write(f"\x1b[0Ksection_start:{stamp}:{args.name}{options}\r\x1b[0K{title}\n")
    else:
        sys.stdout.write(f"\x1b[0Ksection_end:{stamp}:{args.name}\r\x1b[0K")
    sys.stdout.flush()


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "section":
        section(sys.argv[2:])
        return
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("state", choices=STATES)
    parser.add_argument("check_id")
    parser.add_argument("title", nargs="?")
    parser.add_argument("--message")
    parser.add_argument("--progress", type=float)
    parser.add_argument("--current", type=float)
    parser.add_argument("--total", type=float)
    parser.add_argument("--duration-ms", type=int)
    parser.add_argument("--metric", action="append", default=[], metavar="KEY=VALUE")
    parser.add_argument("--job")
    parser.add_argument("--step")
    parser.add_argument("--task", type=int)
    parser.add_argument("--node")
    parser.add_argument("--root")
    parser.add_argument("--print-event", action="store_true", help="also print the event JSON to stdout")
    args = parser.parse_args()
    for metric in args.metric:
        if "=" not in metric:
            parser.error("--metric must be KEY=VALUE")
    emit(args)


if __name__ == "__main__":
    main()
